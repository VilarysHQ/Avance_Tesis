# Puerto donde escuchará la API
PORT=3001

# Cadena de conexión a PostgreSQL local.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BASE
# Reemplaza los valores por los de tu instalación local.
DATABASE_URL=postgresql://postgres:password@localhost:5432/predict_sale

# Máximo de conexiones del pool. Para Render Free se recomienda comenzar con 5.
DB_POOL_MAX=10

# En producción, DATABASE_URL debe incluir sslmode=verify-full y sslrootcert.
# En Render, carga prod-supabase.crt como Secret File y usa:
# sslrootcert=/etc/secrets/prod-supabase.crt

# Base separada y descartable para pruebas de escritura. Nunca apuntar a producción.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/predict_sale_test

# Gemini API (obtén tu clave en Google AI Studio; nunca la subas a Git)
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Origen exacto del frontend. Puede ser una lista separada por comas.
CORS_ORIGIN=http://localhost:5173

# Seguridad administrativa. Nunca guardar aquí valores reales.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$32768$8$3$REPLACE_WITH_SALT$REPLACE_WITH_HASH
ADMIN_SESSION_SECRET=replace_me
ADMIN_SESSION_TTL_MINUTES=30

# Render/Vercel deben usar NODE_ENV=production.
NODE_ENV=development
